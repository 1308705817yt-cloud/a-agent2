                "name": "region",
                "type": "text",
                "nullable": false,
                "aliases": [
                  "地区"
                ]
              },
              {
                "name": "quantity",
                "type": "integer",
                "nullable": true,
                "aliases": [
                  "数量"
                ]
              }
            ],
            "primary_key": [],
            "dimensions": [
              "region"
            ],
            "metrics": []
          }
        }
      },
