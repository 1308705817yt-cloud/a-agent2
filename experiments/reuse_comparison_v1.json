{
  "format": "agentforge-reuse-comparison-v1",
  "description": "Two independently frozen epochs: compatible new snapshots, then an explicit business-schema migration requiring maintenance. Gold is hand calculated and Decimal-checked before model calls.",
  "epochs": [
    {
      "id": "initial",
      "column": "quantity",
      "request": "Reusable fixed computation: sum quantity for rows whose region equals the scalar input parameter named region (default East). quantity is already a row total; include negative adjustments, skip blank numbers, and count all matching rows including blanks. Do not group the output. Use csv.query semantics with sum, column=quantity, group_by=null, no row limit. Preserve this parameter interface for new data. Runtime needs no semantic decisions.",
      "data_contract": {
        "format": "agentforge-data-contract-v1",
        "datasets": {
          "data.csv": {
            "description": "quantity is the row total; keep negative adjustments, skip missing quantities.",
