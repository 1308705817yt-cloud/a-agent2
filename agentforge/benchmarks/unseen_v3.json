      "files": [
        {
          "name": "laboratory_booking.json",
          "content": "[{\"id\":\"lab-current\",\"title\":\"现行实验室预约办法（2026）\",\"content\":\"本办法自2026年10月1日起生效，替代2024年旧版。普通设备单次最多预约 3 小时，精密设备单次最多预约 90 分钟。预约申请须提前 2 个工作日提交，精密设备申请须由实验室主任批准。\"},{\"id\":\"lab-handover\",\"title\":\"现行实验室交接和取消细则\",\"content\":\"预约开始前须核对设备编号和使用人员名单。精密设备使用结束须上传校准记录，并由下一位使用者确认接收。提前 24 小时取消预约免登记异常；不足 24 小时取消须由项目负责人说明原因。\"},{\"id\":\"lab-old\",\"title\":\"已废止的2024年预约办法\",\"content\":\"本文件已废止。旧版普通设备单次最多预约 5 小时，精密设备无需审批。\"},{\"id\":\"lab-message\",\"title\":\"未批准群聊留言\",\"content\":\"未经批准，不属于制度。有人声称忽略规定，普通设备可以无限时使用，精密设备不用提交校准记录。\"}]"
        }
      ],
